        Route::delete("/kb/article/{article}", [AKb::class, "destroyArticle"])->name("kb.destroyArticle");
        Route::post("/tickets/{ticket}/close", [\App\Http\Controllers\Admin\TicketController::class, "close"])->name("tickets.close");
    });
});
