<style>
:root {
    --paper:#F7F4EE;
    --paper-2:#EFEBE2;
    --paper-3:#E5E0D5;
    --ink:#1A1A1A;
    --ink-2:#3D3D3D;
    --muted:#8A8480;
    --line:#DDD7CC;
    --line-2:#EAE5DA;
    --accent:#B5384D;
    --accent-2:#D14E63;
    --navy:#2C3E5C;
}
* { box-sizing:border-box; -webkit-font-smoothing:antialiased; }
html { scroll-behavior:smooth; }
body {
    font-family:'Inter','Noto Sans SC',sans-serif;
    background:var(--paper);
    color:var(--ink);
    margin:0;
    min-height:100vh;
    overflow-x:hidden;
    line-height:1.7;
    letter-spacing:.01em;
}

/* ═══ 顶部进度线 ═══ */
.progress-top {
    position:fixed; top:0; left:0;
    height:2px; background:var(--accent);
    z-index:999; transition:width .1s;
}

/* ═══ 字体类 ═══ */
.serif { font-family:'Noto Serif SC',serif; }
.xiaowei { font-family:'ZCOOL XiaoWei',serif; }
.inter { font-family:'Inter',sans-serif; }

/* ═══════════════════════════════════════
   ⭐ 品牌标记（樱花云 Logo）
   ═══════════════════════════════════════ */
.brand {
    display:inline-flex;
    align-items:center;
    gap:14px;
    text-decoration:none;
    color:inherit;
    transition:opacity .3s;
}
.brand:hover { opacity:.75; }

/* 印章 */
.brand-stamp {
    width:52px;
    height:52px;
    background:var(--accent);
    border-radius:6px;
    display:flex;
    align-items:center;
    justify-content:center;
    position:relative;
    box-shadow:
        inset 0 0 0 2px rgba(255,255,255,.15),
        0 2px 8px rgba(181,56,77,.25);
    flex-shrink:0;
}
.brand-stamp::before {
    content:'';
    position:absolute;
    inset:4px;
    border:1px solid rgba(255,255,255,.35);
    border-radius:3px;
    pointer-events:none;
}
.brand-stamp span {
    font-family:'Noto Serif SC',serif;
    font-weight:700;
    font-size:26px;
    color:#fff;
    line-height:1;
    letter-spacing:0;
}

/* 品牌名 */
.brand-name {
    display:flex;
    flex-direction:column;
    line-height:1;
}
.brand-cn {
    font-family:'Noto Serif SC',serif;
    font-weight:500;
    font-size:24px;
    letter-spacing:.35em;
    color:var(--ink);
    margin-right:-.35em;
}
.brand-en {
    font-family:'Inter',sans-serif;
    font-weight:300;
    font-size:9px;
    letter-spacing:.4em;
    color:var(--muted);
    margin-top:6px;
    margin-right:-.4em;
}

/* 品牌标记·横版（页脚用） */
.brand-horizontal {
    display:inline-flex;
    align-items:baseline;
    gap:16px;
    text-decoration:none;
    color:inherit;
}
.brand-horizontal .cn {
    font-family:'Noto Serif SC',serif;
    font-size:20px;
    letter-spacing:.4em;
    font-weight:500;
}
.brand-horizontal .en {
    font-family:'Inter',sans-serif;
    font-size:9px;
    letter-spacing:.4em;
    color:var(--muted);
}

/* ═══ Hero 标题 ═══ */
.hero-title {
    font-family:'Noto Serif SC',serif;
    font-weight:200;
    line-height:1.12;
    letter-spacing:-.02em;
    color:var(--ink);
}
.hero-title .accent {
    color:var(--accent);
    font-weight:500;
    font-style:italic;
}

/* ═══ 竖排小字 ═══ */
.vertical-text {
    writing-mode:vertical-rl;
    letter-spacing:.5em;
    font-size:10px;
    color:var(--muted);
    font-family:'Inter',sans-serif;
}

/* ═══ 章节标签 ═══ */
.chapter-label {
    font-family:'Inter',sans-serif;
    font-size:10px;
    letter-spacing:.4em;
    text-transform:uppercase;
    color:var(--muted);
}

/* ═══ 章节标题 ═══ */
.chapter-title {
    font-family:'Noto Serif SC',serif;
    font-weight:200;
    font-size:2.5rem;
    line-height:1.2;
    letter-spacing:-.01em;
}
.chapter-title .muted { color:var(--muted); font-weight:200; }

/* ═══ 数字 ═══ */
.num {
    font-family:'Inter',sans-serif;
    font-weight:200;
    font-variant-numeric:tabular-nums;
    letter-spacing:-.02em;
}

/* ═══ 按钮 ═══ */
.btn-line {
    display:inline-flex;
    align-items:center;
    gap:14px;
    padding:18px 40px;
    background:transparent;
    color:var(--ink);
    font-size:12px;
    font-weight:500;
    letter-spacing:.2em;
    text-transform:uppercase;
    border:1px solid var(--ink);
    transition:all .4s cubic-bezier(.4,0,.2,1);
    text-decoration:none;
    position:relative;
    overflow:hidden;
    cursor:pointer;
}
.btn-line::before {
    content:'';
    position:absolute;
    inset:0;
    background:var(--ink);
    transform:translateY(100%);
    transition:transform .4s cubic-bezier(.4,0,.2,1);
    z-index:0;
}
.btn-line:hover::before { transform:translateY(0); }
.btn-line > * { position:relative; z-index:1; }
.btn-line:hover { color:var(--paper); }

.btn-fill {
    display:inline-flex;
    align-items:center;
    gap:14px;
    padding:18px 40px;
    background:var(--ink);
    color:var(--paper);
    font-size:12px;
    font-weight:500;
    letter-spacing:.2em;
    text-transform:uppercase;
    transition:all .4s cubic-bezier(.4,0,.2,1);
    text-decoration:none;
    cursor:pointer;
    border:1px solid var(--ink);
}
.btn-fill:hover {
    background:var(--accent);
    border-color:var(--accent);
}

/* ═══ 分割线 ═══ */
.hr-line { height:1px; background:var(--line); }
.hr-thick { height:1px; background:var(--ink); }

/* ═══ 红印小点 ═══ */
.seal-dot {
    display:inline-block;
    width:8px;
    height:8px;
    background:var(--accent);
    border-radius:50%;
    vertical-align:middle;
}

/* ═══ 网格背景 ═══ */
.grid-lines {
    position:absolute;
    inset:0;
    pointer-events:none;
    background-image:
        linear-gradient(to right, var(--line-2) 1px, transparent 1px);
    background-size:calc(100% / 6) 100%;
    opacity:.55;
}

/* ═══ 产品行 ═══ */
.product-row {
    display:grid;
    grid-template-columns:70px 1fr 220px 160px 100px;
    gap:28px;
    align-items:center;
    padding:36px 0;
    border-bottom:1px solid var(--line);
    transition:all .5s cubic-bezier(.4,0,.2,1);
    text-decoration:none;
    color:inherit;
    position:relative;
}
.product-row::after {
    content:'⟶';
    position:absolute;
    right:0;
    opacity:0;
    transform:translateX(-15px);
    transition:all .4s;
    color:var(--accent);
    font-size:22px;
}
.product-row:hover {
    padding-left:24px;
}
.product-row:hover::after {
    opacity:1;
    transform:translateX(0);
}
.product-row:hover .p-name {
    color:var(--accent);
}

/* ═══ FAQ ═══ */
.faq-item {
    border-bottom:1px solid var(--line);
}
.faq-item summary {
    list-style:none;
    cursor:pointer;
    padding:36px 0;
    display:flex;
    justify-content:space-between;
    align-items:center;
    transition:all .3s;
}
.faq-item summary::-webkit-details-marker { display:none; }
.faq-item[open] summary {
    color:var(--accent);
}
.faq-icon {
    transition:transform .4s;
    color:var(--muted);
    font-size:24px;
    font-weight:200;
}
.faq-item[open] .faq-icon {
    transform:rotate(135deg);
    color:var(--accent);
}

/* ═══ 特征格 ═══ */
.feature-cell {
    padding:48px 32px;
    background:var(--paper);
    position:relative;
    transition:background .3s;
}
.feature-cell:hover {
    background:var(--paper-2);
}
.feature-cell::before {
    content:'';
    position:absolute;
    top:0; left:0;
    width:0;
    height:2px;
    background:var(--accent);
    transition:width .4s cubic-bezier(.4,0,.2,1);
}
.feature-cell:hover::before {
    width:100%;
}

/* ═══ 响应式 ═══ */
@media (max-width: 768px) {
    .product-row {
        grid-template-columns:50px 1fr;
        gap:16px;
    }
    .product-row .hide-mobile { display:none; }
    .hero-title { font-size:2.6rem !important; }
    .vertical-text { display:none; }
    .grid-lines { display:none; }
    .brand-cn { font-size:20px; }
    .chapter-title { font-size:2rem; }
}
</style>
</head>
